# ==============================================================================
# SpendWise Environment Configuration Example
# Copy this file to .env and adjust variables for your local/production setup
# ==============================================================================

# Database Settings
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=spendwise_db
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Full Database Connection String (Used by FastAPI & Alembic)
# For local dev without Docker, you can use: sqlite:///./spendwise.db
DATABASE_URL=postgresql://spendwise:your_secure_database_password_here@localhost:5432/spendwise_db

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Google Gemini AI Integration for natural-language spending summaries
# Leave empty to use SpendWise's built-in deterministic heuristic rule engine
GEMINI_API_KEY=your_gemini_api_key_here
